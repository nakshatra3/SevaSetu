# Copy this file to .env (same folder) and fill in your own values.
# Never commit the real .env file.

# Local MongoDB (default install) ...
MONGODB_URI=mongodb://localhost:27017
# ... or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=volunteer_platform

# Required. Generate a random value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend address(es) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by seed.py
ADMIN_EMAIL=admin@sevasetu.demo
ADMIN_PASSWORD=change-this-admin-password
DEMO_PASSWORD=change-this-demo-password
