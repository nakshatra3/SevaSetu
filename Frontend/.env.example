# Copy this file to .env and adjust.

# Where the browser sends API calls.
# Dev: keep "/api/v1" (Vite proxies /api to VITE_API_PROXY_TARGET).
# Production: full URL, e.g. https://api.sevasetu.org/api/v1
VITE_API_BASE_URL=/api/v1

# FastAPI server used by the dev proxy.
VITE_API_PROXY_TARGET=http://localhost:8000

# Auth: false = talk to the real FastAPI /auth endpoints.
#       true  = fake in-memory accounts (no backend needed).
VITE_USE_MOCK_AUTH=false

# Everything else (profiles, notifications, admin, reports) has no backend yet.
# true  = use fake data from src/api/mock
# false = call the real endpoints listed in BACKEND_CONTRACT.md
VITE_USE_MOCK_DATA=true
